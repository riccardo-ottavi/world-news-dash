datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Source {
  id        String    @id @default(cuid())
  name      String
  url       String    @unique
  category  String?
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  link        String    @unique
  content     String?
  publishedAt DateTime?
  hash        String    @unique
  sourceId    String
  createdAt   DateTime  @default(now())
  source      Source    @relation(fields: [sourceId], references: [id])
}
